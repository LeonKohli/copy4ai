node_modules
.vscode-test/
*.vsix
out/
coverage/
.DS_Store

# The test suite writes fixtures into the checked-in test workspace and cleans
# them up in teardown, but a crashed run must not dirty the repo. Everything in
# there is transient except the files listed below.
test/testWorkspace/*
!test/testWorkspace/.gitignore
!test/testWorkspace/.vscode/
!test/testWorkspace/app.js
!test/testWorkspace/src/
!test/testWorkspace/vendor/
